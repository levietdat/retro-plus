# Bắt buộc: mật khẩu vào trang /admin
ADMIN_PASSWORD=doi-mat-khau-nay
# Khuyên dùng: chuỗi ngẫu nhiên dài để ký cookie đăng nhập
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Thực đơn: "static" (mặc định, menu có sẵn trong code) hoặc "kiotviet"
MENU_SOURCE=static

# KiotViet FnB (điền khi đã có key từ Thiết lập kết nối API)
KIOTVIET_RETAILER=retrohue
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
# Đẩy đơn web về KiotViet để hiện trên máy POS (true/false) + ID chi nhánh
KIOTVIET_PUSH_ORDERS=false
KIOTVIET_BRANCH_ID=

# Lưu đơn: tự dùng Netlify Blobs khi chạy trên Netlify, còn lại lưu file JSON trong DATA_DIR
# STORAGE_DRIVER=file
# DATA_DIR=./data

# Thời gian chờ ước tính = số ly đang chờ × phút mỗi ly ÷ số người pha
PREP_MINUTES_PER_CUP=2
BARISTAS=1

# Thanh toán VietQR trên trang đơn (bỏ trống thì chỉ hiện "thanh toán tại quầy")
# BANK_ID: mã ngân hàng theo VietQR, vd VCB, MB, TCB, ACB, VPB, BIDV, ICB (VietinBank)
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
